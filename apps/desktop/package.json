{
  "name": "@projo/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bunx @tauri-apps/cli@2.12.4 dev",
    "build": "bunx @tauri-apps/cli@2.12.4 build",
    "build:ui": "bun -e \"require('node:fs').rmSync('ui/dist', { recursive: true, force: true })\" && bun build ./ui/index.html --outdir ./ui/dist --minify",
    "fetch-libmpv": "bun scripts/fetch-libmpv.ts",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "typecheck": "bun check"
  },
  "devDependencies": {
    "@types/bun": "1.4.4"
  }
}
