    "i18next": "26.5.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.4"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "vite": "8.3.5"
