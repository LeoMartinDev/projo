{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The bundled page (http://tauri.localhost), the only page of the main window: every app command of §28.6, the window buttons, full screen and the app's events. No remote URL is ever granted.",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "allow-mpv-init",
    "allow-mpv-command",
    "allow-mpv-set-property",
    "allow-mpv-get-property",
    "allow-mpv-observe",
    "allow-mpv-destroy",
    "allow-desktop-info",
    "allow-desktop-device",
    "allow-desktop-update-status",
    "allow-desktop-update-install",
    "allow-get-server",
    "allow-check-server",
    "allow-save-server",
    "allow-get-token",
    "allow-set-token",
    "allow-clear-token",
    "allow-change-server",
    "allow-media-session-set",
    "allow-media-session-state",
    "allow-media-session-clear",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "core:window:allow-is-maximized",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-start-dragging",
    "core:window:allow-close"
  ]
}
