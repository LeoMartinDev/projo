{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "projo",
  "version": "../package.json",
  "identifier": "dev.leomartin.projo.desktop",
  "build": {
    "frontendDist": "../web/dist",
    "beforeDevCommand": "bun run build:web",
    "beforeBuildCommand": "bun run build:web"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self' data:; img-src 'self' http: https: data: blob:; media-src 'self' http: https: data: blob:; connect-src 'self' ipc: http://ipc.localhost http: https: data: blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": { "lib/libmpv-2.dll": "lib/libmpv-2.dll" },
    "windows": { "nsis": { "installMode": "currentUser" } }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVDMjBGMjAzQkU1NTVDRkEKUldUNlhGVytBL0lnWE5DVE5XeWhqYUwyaXhqdVYyQk9Yb1dMaDBKM1IvcUE3ODdFbERQRFZMZWkK",
      "requireSignedVersion": true,
      "windows": { "installMode": "quiet" }
    }
  }
}
