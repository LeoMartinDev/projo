{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "projo",
  "version": "0.1.0",
  "identifier": "dev.leomartin.projo.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "beforeDevCommand": "bun run build:ui",
    "beforeBuildCommand": "bun run build:ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": { "lib/libmpv-2.dll": "lib/libmpv-2.dll" },
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
