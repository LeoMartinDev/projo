{
  "expo": {
    "name": "projo",
    "slug": "projo",
    "version": "1.0.0",
    "scheme": "projo",
    "platforms": ["ios", "android"],
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0a0b",
    "ios": {
      "bundleIdentifier": "dev.leomartin.projo",
      "supportsTablet": true,
      "deploymentTarget": "17.0",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "projo connects to your projo server on your local network.",
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "package": "dev.leomartin.projo"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-camera",
        {
          "cameraPermission": "projo uses the camera to scan the code shown by “Connect a device”.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ]
    ]
  }
}
